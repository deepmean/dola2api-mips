# Build output
dist/
*.exe

# Local runtime state (never committed: accounts, proxies, tasks, downloads)
accounts.json
proxies.json
tasks.jsonl
pool_usage.db
dola2api.conf
downloads/
*.log

# Credentials. A sessionid is a live login for a real account: it must never
# reach a commit, and the router reads it from a 0600 file instead.
cookies.txt
cookies*.txt
*.cookie
.env
.env.local

# Probe output can contain signed CDN URLs, conversation ids and challenge blobs.
spikes/protocol_result.json
spikes/verify_result.json
spikes/submit_diag_result.json

# Python bytecode from running the spike scripts.
__pycache__/
*.pyc

# CDP cookie array (live credentials).
spikes/cookies.cdp.json

# Captured signed URL (contains a live a_bogus signature).
spikes/captured_submit_url.txt
spikes/tls_impersonate_result.json
spikes/tls_after_browser.json
spikes/poll_check_result.json
spikes/bdms-sdk.js
spikes/public/
spikes/goja_probe/
spikes/abogus_probe/
spikes/abogus_submit/
spikes/webmssdk.js
